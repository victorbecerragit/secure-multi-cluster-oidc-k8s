aws_region    = "us-east-1"
cluster_name  = "secure-dev-eks"
name_prefix   = "secure-mc"
# Set this if bootstrap was applied with a different name_prefix than above.
# Example: deploy_role_name_prefix = "kube-refresh-dev"
# deploy_role_name_prefix = ""
github_owner  = "victorbecerragit"
github_repo   = "secure-multi-cluster-oidc-k8s"

github_subject_type  = "branch"
github_subject_value = "main"

# Optional managed policy extensions. Keep empty unless the inline CI policy needs temporary augmentation.
github_actions_managed_policy_arns = []

github_actions_eks_access_policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
github_actions_eks_access_scope_type   = "cluster"
github_actions_eks_access_namespaces   = []

# ---------------------------------------------------------------------------
# Deploy role – separate identity for kubectl apply (no infra permissions)
# ---------------------------------------------------------------------------
# The subject value must match the branch or GitHub environment name used in
# the deployment workflow. Using a named environment (e.g. "eks-deploy")
# is recommended for production so that required-reviewer protection applies.
github_deploy_subject_value = "main"
# github_deploy_subject_value = "eks-deploy"   # switch to a named environment in production

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3

# Use this only for temporary dev access from public GitHub-hosted runners.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# Production: restrict this to your home/VPN egress IPs or move to private runners.
# cluster_endpoint_public_access_cidrs = [
#   "YOUR_HOME_IP/32",
#   "YOUR_VPN_EGRESS_IP/32"
# ]